{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thinkbot",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },

  // Triage runs in waitUntil after the response has gone out, so a failure
  // there is invisible from the caller's side — it answers 200 either way.
  // Without logs the only symptom is a message that never arrives.
  "observability": { "enabled": true },

  // Triage runs here, not in a waitUntil. A waitUntil gets about thirty
  // seconds after the response, and a tool-calling turn regularly needs more —
  // the runtime was cancelling them outright, with no error and no message.
  //
  // Create with: wrangler queues create thinkbot-triage
  "queues": {
    "producers": [{ "queue": "thinkbot-triage", "binding": "TRIAGE_QUEUE" }],
    "consumers": [
      {
        // One job at a time: batching would only make a slow turn wait behind
        // another slow turn, and each job posts on its own.
        "queue": "thinkbot-triage",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        // Retries are off deliberately. A retried turn may already have posted
        // its finding, so retrying risks a duplicate explanation under an
        // incident someone is reading.
        "max_retries": 0,
        "dead_letter_queue": "thinkbot-triage-dlq"
      }
    ]
  },

  // No public surface. thinkbot holds a GitHub PAT, Datadog and Sentry keys,
  // and write access to monitoring incidents. Inbound traffic is signed
  // webhooks only (Slack, Telegram, clawdwatch), each verified before any
  // work happens.
  //
  // There is no "assets" block, and that is load-bearing rather than an
  // omission. Assets are matched before the Worker runs, so a static bundle
  // is a second, unauthenticated way into this hostname that no route guard
  // sees: it served the chat shell for any unmatched GET, answered every
  // signed inbox with 405 because the asset handler rejects non-GET, and
  // returned a 200 for /health that the Worker never produced. With no
  // assets, every request reaches the code that checks callers.
  "workers_dev": false,
  "preview_urls": false,
  // Add your own hostname here, e.g.
  //   "routes": [{ "pattern": "thinkbot.example.com", "custom_domain": true }]
  // Left unset so a fork does not try to claim someone else's domain.
  // ChatAgent is gone along with the chat UI: every caller wants one turn and
  // an answer, which runOpsTurn provides without a Durable Object. The v2
  // migration deletes the class and its stored chat history; keep v1 in place,
  // because migrations are a log and Cloudflare replays it in order.
  "migrations": [
    {
      "new_sqlite_classes": ["ChatAgent"],
      "tag": "v1"
    },
    {
      "deleted_classes": ["ChatAgent"],
      "tag": "v2"
    }
  ]
}
